# OpenSSL configuration for the mls-tls FIPS test image. `@PREFIX@` is substituted at image build.
#
# This deliberately makes the FIPS module *available* without activating it: `mls_tls::fips::enable()`
# calls OSSL_PROVIDER_load for both `fips` and `base` and then sets `fips=yes` as the default
# property. Activating here as well would load providers during library init, taking the ordering
# out of the application's hands.
#
# For a deployment that prefers config-driven activation instead, add `activate = 1` to
# `[fips_sect]` (in fipsmodule.cnf), `[base_sect]`, and an `[algorithm_sect]` with
# `default_properties = fips=yes`. `mls_tls::fips::enable()` stays correct either way — it is
# idempotent and its provider loads are no-ops once the module is already active.

config_diagnostics = 1
openssl_conf = openssl_init

# Supplies [fips_sect] with the module's MAC and self-test status. Generated by `openssl
# fipsinstall`; its `activate` line is stripped in the Dockerfile.
.include @PREFIX@/ssl/fipsmodule.cnf

[openssl_init]
providers = provider_sect

[provider_sect]
fips = fips_sect
base = base_sect

# Intentionally empty: no `activate`, because fips_module(7) requires the line to be ABSENT (not
# `= 0`) when the application loads providers itself.
[base_sect]
